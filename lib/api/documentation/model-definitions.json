{
  "Server": {
    "type": "object",
    "required": ["id", "name", "version"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "服务器唯一标识符"
      },
      "name": {
        "type": "string",
        "description": "服务器名称"
      },
      "description": {
        "type": "string",
        "description": "服务器描述"
      },
      "version": {
        "type": "string",
        "description": "服务器版本号（语义化版本）"
      },
      "author": {
        "type": "string",
        "description": "服务器作者"
      },
      "homepage": {
        "type": "string",
        "format": "uri",
        "description": "服务器主页URL"
      },
      "repository": {
        "type": "string",
        "format": "uri",
        "description": "服务器代码仓库URL"
      },
      "downloads": {
        "type": "integer",
        "description": "服务器下载次数"
      },
      "rating": {
        "type": "number",
        "format": "float",
        "description": "服务器平均评分（1-5）"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "description": "服务器创建时间"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "description": "服务器更新时间"
      }
    }
  },
  "User": {
    "type": "object",
    "required": ["id", "email", "username"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "用户唯一标识符"
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "用户电子邮件"
      },
      "username": {
        "type": "string",
        "description": "用户名"
      },
      "name": {
        "type": "string",
        "description": "用户显示名称"
      },
      "avatar": {
        "type": "string",
        "format": "uri",
        "description": "用户头像URL"
      },
      "bio": {
        "type": "string",
        "description": "用户简介"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "description": "用户创建时间"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "description": "用户更新时间"
      }
    }
  },
  "Tool": {
    "type": "object",
    "required": ["name", "description", "parameters"],
    "properties": {
      "name": {
        "type": "string",
        "description": "工具名称"
      },
      "description": {
        "type": "string",
        "description": "工具功能描述"
      },
      "parameters": {
        "type": "object",
        "description": "工具参数定义"
      }
    }
  },
  "ServerCollection": {
    "type": "object",
    "required": ["id", "name", "createdBy"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "集合唯一标识符"
      },
      "name": {
        "type": "string",
        "description": "集合名称"
      },
      "description": {
        "type": "string",
        "description": "集合描述"
      },
      "isPublic": {
        "type": "boolean",
        "description": "是否公开可见"
      },
      "createdBy": {
        "type": "string",
        "format": "uuid",
        "description": "创建者用户ID"
      },
      "servers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "服务器ID"
            },
            "order": {
              "type": "integer",
              "description": "在集合中的顺序"
            }
          }
        },
        "description": "集合中的服务器列表"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "description": "集合创建时间"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "description": "集合更新时间"
      }
    }
  },
  "Webhook": {
    "type": "object",
    "required": ["id", "url", "events", "createdBy"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "Webhook唯一标识符"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "Webhook回调URL"
      },
      "events": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["server.create", "server.update", "server.delete", "server.download"]
        },
        "description": "触发Webhook的事件类型"
      },
      "secret": {
        "type": "string",
        "description": "用于签名的密钥（仅创建时返回一次）"
      },
      "active": {
        "type": "boolean",
        "description": "Webhook是否激活"
      },
      "createdBy": {
        "type": "string",
        "format": "uuid",
        "description": "创建者用户ID"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "description": "Webhook创建时间"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "description": "Webhook更新时间"
      }
    }
  },
  "Notification": {
    "type": "object",
    "required": ["id", "userId", "type", "message"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "通知唯一标识符"
      },
      "userId": {
        "type": "string",
        "format": "uuid",
        "description": "接收通知的用户ID"
      },
      "type": {
        "type": "string",
        "enum": ["info", "warning", "error", "success", "update"],
        "description": "通知类型"
      },
      "title": {
        "type": "string",
        "description": "通知标题"
      },
      "message": {
        "type": "string",
        "description": "通知内容"
      },
      "link": {
        "type": "string",
        "format": "uri",
        "description": "相关链接"
      },
      "isRead": {
        "type": "boolean",
        "description": "是否已读"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "description": "通知创建时间"
      }
    }
  },
  "ServerStats": {
    "type": "object",
    "required": ["serverId"],
    "properties": {
      "serverId": {
        "type": "string",
        "format": "uuid",
        "description": "服务器ID"
      },
      "downloads": {
        "type": "integer",
        "description": "总下载次数"
      },
      "dailyDownloads": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        },
        "description": "每日下载次数统计"
      },
      "versions": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        },
        "description": "各版本下载次数统计"
      },
      "platforms": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        },
        "description": "各平台下载次数统计"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "description": "统计数据更新时间"
      }
    }
  },
  "Recommendation": {
    "type": "object",
    "required": ["id", "serverId", "score"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "推荐唯一标识符"
      },
      "serverId": {
        "type": "string",
        "format": "uuid",
        "description": "服务器ID"
      },
      "name": {
        "type": "string",
        "description": "服务器名称"
      },
      "description": {
        "type": "string",
        "description": "服务器描述"
      },
      "version": {
        "type": "string",
        "description": "服务器版本"
      },
      "downloads": {
        "type": "integer",
        "description": "下载次数"
      },
      "rating": {
        "type": "number",
        "format": "float",
        "description": "平均评分"
      },
      "score": {
        "type": "number",
        "format": "float",
        "description": "推荐分数"
      },
      "reason": {
        "type": "string",
        "description": "推荐原因"
      }
    }
  },
  "Error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string",
        "description": "错误信息"
      },
      "errors": {
        "type": "object",
        "description": "详细错误信息"
      }
    }
  }
} 