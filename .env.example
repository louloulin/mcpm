# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://mcpmuser:mcpmpassword@localhost:5432/mcpm

# Authentication
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Glama API
GLAMA_API_URL=https://api.glama.ai
GLAMA_API_KEY=your_glama_api_key

# Sync Configuration
SYNC_INTERVAL=86400000 # 24 hours in milliseconds 

# API配置
API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ===== 应用配置 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000  # 生产环境修改为实际URL

# ===== 数据库初始化 =====
RUN_MIGRATIONS=true
SEED_DATABASE=true 