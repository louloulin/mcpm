# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcpsvr
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mcpsvr

# API配置
API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# JWT配置
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# 其他配置
NODE_ENV=development
PORT=3000

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000 