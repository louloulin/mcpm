{
  "name": "mcpsvr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "start:api": "ts-node lib/server.ts",
    "dev:api": "nodemon --exec ts-node lib/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r esbuild-register drizzle/migrate.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker-compose down && docker-compose up -d postgres && sleep 5 && pnpm db:migrate && pnpm db:seed",
    "db:push": "drizzle-kit push:pg",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest"
  },
