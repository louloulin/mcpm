{
  "id": "mcp-basic-service",
  "name": "MCP基础服务模板",
  "version": "1.0.0",
  "description": "创建一个基础的MCP服务，包含多个工具示例",
  "author": "MCPM Team",
  "license": "MIT",
  "tags": ["starter", "service", "mcp", "v3"],
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "src/**/*",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "tools": [
    {
      "id": "text-processor",
      "name": "文本处理工具",
      "description": "提供文本摘要、翻译等基础功能",
      "inputs": [
        {
          "name": "text",
          "type": "string",
          "description": "要处理的文本内容",
          "required": true
        },
        {
          "name": "action",
          "type": "string",
          "description": "处理动作: summarize, translate",
          "required": true
        },
        {
          "name": "options",
          "type": "object",
          "description": "额外选项",
          "required": false
        }
      ],
      "outputs": {
        "result": "string",
        "metadata": "object"
      }
    },
    {
      "id": "image-analyzer",
      "name": "图像分析工具",
      "description": "分析图像内容、标签和特征",
      "inputs": [
        {
          "name": "imageUrl",
          "type": "string",
          "description": "图像URL",
          "required": true
        },
        {
          "name": "features",
          "type": "array",
          "description": "要分析的特征列表",
          "required": false
        }
      ],
      "outputs": {
        "tags": "array",
        "objects": "array",
        "colors": "array"
      }
    },
    {
      "id": "data-transformer",
      "name": "数据转换工具",
      "description": "在不同格式间转换数据",
      "inputs": [
        {
          "name": "data",
          "type": "any",
          "description": "要转换的数据",
          "required": true
        },
        {
          "name": "sourceFormat",
          "type": "string",
          "description": "源格式",
          "required": true
        },
        {
          "name": "targetFormat",
          "type": "string",
          "description": "目标格式",
          "required": true
        }
      ],
      "outputs": {
        "result": "any",
        "success": "boolean",
        "errors": "array"
      }
    }
  ],
  "config": {
    "port": 3100,
    "apiPath": "/api",
    "auth": {
      "enabled": true,
      "type": "api_key"
    }
  },
  "requirements": {
    "dependencies": [
      "express",
      "zod",
      "mcpm"
    ],
    "devDependencies": [
      "jest",
      "supertest",
      "nodemon"
    ]
  },
  "customization": {
    "variables": [
      {
        "name": "SERVICE_NAME",
        "description": "服务名称",
        "default": "mcp-service",
        "type": "string"
      },
      {
        "name": "SERVICE_DESCRIPTION",
        "description": "服务描述",
        "default": "MCP服务示例",
        "type": "string"
      },
      {
        "name": "AUTHOR_NAME",
        "description": "作者名称",
        "default": "Your Name",
        "type": "string"
      },
      {
        "name": "AUTHOR_EMAIL",
        "description": "作者邮箱",
        "default": "your.email@example.com",
        "type": "string"
      },
      {
        "name": "PORT",
        "description": "服务端口",
        "default": 3100,
        "type": "number"
      },
      {
        "name": "INCLUDE_IMAGE_TOOL",
        "description": "是否包含图像处理工具",
        "default": true,
        "type": "boolean"
      }
    ]
  },
  "documentation": {
    "homepage": "https://github.com/mcpm/templates/basic-service",
    "usage": "使用 `mcpm v3 create --template mcp-basic-service` 创建新项目",
    "examples": [
      {
        "title": "创建默认项目",
        "command": "mcpm v3 create my-service --template mcp-basic-service"
      },
      {
        "title": "自定义服务名称和端口",
        "command": "mcpm v3 create --template mcp-basic-service --var.SERVICE_NAME=\"AI文本服务\" --var.PORT=4000"
      }
    ]
  }
} 